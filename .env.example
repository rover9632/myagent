# ---------------- LLM / vLLM ----------------
# vLLM OpenAI-compatible endpoint.
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_API_KEY=EMPTY
# Must match the model name exposed by vLLM.
LLM_MODEL=Qwen/Qwen3-8B
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2

# ---------------- Tavily ----------------
TAVILY_API_KEY=
TAVILY_MAX_RESULTS=5

# ---------------- Docker Sandbox ----------------
SANDBOX_IMAGE=agent-sandbox:py312
SANDBOX_WORKSPACE_ROOT=./data/workspaces
SANDBOX_DEFAULT_TIMEOUT_SECONDS=30
SANDBOX_MAX_TIMEOUT_SECONDS=120
SANDBOX_MEMORY=512m
SANDBOX_CPUS=1.0
SANDBOX_PIDS_LIMIT=64
SANDBOX_MAX_OUTPUT_BYTES=12000
# Delete thread workspaces idle for this many days; 0 disables cleanup.
SANDBOX_WORKSPACE_TTL_DAYS=7

# ---------------- DATABASE ----------------
# PostgreSQL for users, sessions and LangGraph conversation checkpoints.
# Plain libpq URI only: postgresql://user:password@host:port/dbname
PG_URI=postgresql://postgres:CHANGE-ME@127.0.0.1:5432/myagent
PG_POOL_MIN_SIZE=2
PG_POOL_MAX_SIZE=10
# Login sessions expire after this many days.
SESSION_TTL_DAYS=30

# ---------------- API ----------------
HOST=0.0.0.0
PORT=8061
LOG_LEVEL=INFO

# ---------------- COS (Tencent Cloud object storage) ----------------
# Tool-generated files (merged PDFs, rendered pages) are uploaded here and the
# public URL replaces the file in agent replies. COS_CONF is parsed as JSON and
# passed to qcloud_cos.CosConfig, e.g.
# {"Region":"ap-shanghai","SecretId":"...","SecretKey":"..."}
# Without valid values the file tools fail with "cloud upload failed".
COS_CONF={}
COS_BUCKET=
